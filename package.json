{
  "name": "agentmoney",
  "version": "1.0.0",
  "description": "Track what your AI agents actually spend. Real-time cost monitoring for Claude, OpenAI, and other LLM APIs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentmoney": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build && npm run test"
  },
  "keywords": [
    "ai-agent",
    "cost-tracking",
    "claude",
    "openai",
    "llm",
    "api-cost",
    "developer-tools",
    "monitoring",
    "anthropic",
    "token-usage",
    "proxy",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/naman10parikh/agentmoney"
  },
  "homepage": "https://github.com/naman10parikh/agentmoney#readme",
  "bugs": {
    "url": "https://github.com/naman10parikh/agentmoney/issues"
  },
  "author": "Energy Platform",
  "license": "MIT",
  "dependencies": {
    "@e2b/sdk": "^2.5.0",
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
