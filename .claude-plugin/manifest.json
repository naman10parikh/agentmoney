{
  "name": "agentmoney",
  "version": "1.0.0",
  "description": "Real-time cost tracking for Claude, OpenAI, and Gemini API calls. Query costs by model and token count directly from Claude Code.",
  "homepage": "https://github.com/naman10parikh/agentmoney",
  "license": "MIT",
  "mcp": {
    "transport": "stdio",
    "command": "node",
    "args": ["dist/mcp-server.js"],
    "env": {},
    "cwd": "."
  },
  "tools": [
    {
      "name": "cost_query",
      "description": "Calculate the USD cost of an LLM API call. Supports Claude, OpenAI, and Gemini models. Returns input cost, output cost, cache cost, and total cost.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Model identifier (e.g. claude-sonnet-4-6, gpt-4o). Fuzzy-matched."
          },
          "input_tokens": {
            "type": "number",
            "description": "Number of input (prompt) tokens."
          },
          "output_tokens": {
            "type": "number",
            "description": "Number of output (completion) tokens."
          },
          "cache_read_tokens": {
            "type": "number",
            "description": "Anthropic prompt cache-read tokens. Default 0."
          },
          "cache_write_tokens": {
            "type": "number",
            "description": "Anthropic prompt cache-write tokens. Default 0."
          }
        },
        "required": ["model", "input_tokens", "output_tokens"]
      }
    }
  ]
}
